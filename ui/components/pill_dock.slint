import { ThemePalette } from "../theme.slint";
import { IconDisplay, IconSet } from "@lucide";

export component PillDock inherits Rectangle {
    in-out property <int> active_tab: 0; // 0: Library, 1: Playlist, 2: Lyrics, 3: Queue
    in-out property <string> search_query: "";

    callback tab_selected(int);
    callback search_changed(string);
    callback open_settings();

    height: 44px;
    border-radius: 22px;
    background: ThemePalette.bg_elevated;
    border-width: 1px;
    border-color: ThemePalette.border_subtle;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        // Tab 0: Library
        Rectangle {
            width: 84px;
            height: 32px;
            border-radius: 16px;
            background: root.active_tab == 0 ? ThemePalette.accent_primary : (tab0_touch.has-hover ? ThemePalette.bg_hover : transparent);
            y: (parent.height - self.height) / 2;
            animate background { duration: 120ms; }

            Text {
                text: "Pustaka";
                font-size: 12px;
                font-weight: root.active_tab == 0 ? 700 : 500;
                color: root.active_tab == 0 ? #FFFFFF : ThemePalette.text_primary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            tab0_touch := TouchArea {
                clicked => { root.active_tab = 0; root.tab_selected(0); }
            }
        }

        // Tab 1: Playlist
        Rectangle {
            width: 84px;
            height: 32px;
            border-radius: 16px;
            background: root.active_tab == 1 ? ThemePalette.accent_primary : (tab1_pl_touch.has-hover ? ThemePalette.bg_hover : transparent);
            y: (parent.height - self.height) / 2;
            animate background { duration: 120ms; }

            Text {
                text: "Playlist";
                font-size: 12px;
                font-weight: root.active_tab == 1 ? 700 : 500;
                color: root.active_tab == 1 ? #FFFFFF : ThemePalette.text_primary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            tab1_pl_touch := TouchArea {
                clicked => { root.active_tab = 1; root.tab_selected(1); }
            }
        }

        // Tab 2: Lyrics
        Rectangle {
            width: 78px;
            height: 32px;
            border-radius: 16px;
            background: root.active_tab == 2 ? ThemePalette.accent_primary : (tab1_touch.has-hover ? ThemePalette.bg_hover : transparent);
            y: (parent.height - self.height) / 2;
            animate background { duration: 120ms; }

            Text {
                text: "Lirik";
                font-size: 12px;
                font-weight: root.active_tab == 2 ? 700 : 500;
                color: root.active_tab == 2 ? #FFFFFF : ThemePalette.text_primary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            tab1_touch := TouchArea {
                clicked => { root.active_tab = 2; root.tab_selected(2); }
            }
        }

        // Tab 3: Queue
        Rectangle {
            width: 84px;
            height: 32px;
            border-radius: 16px;
            background: root.active_tab == 3 ? ThemePalette.accent_primary : (tab2_touch.has-hover ? ThemePalette.bg_hover : transparent);
            y: (parent.height - self.height) / 2;
            animate background { duration: 120ms; }

            Text {
                text: "Antrean";
                font-size: 12px;
                font-weight: root.active_tab == 3 ? 700 : 500;
                color: root.active_tab == 3 ? #FFFFFF : ThemePalette.text_primary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            tab2_touch := TouchArea {
                clicked => { root.active_tab = 3; root.tab_selected(3); }
            }
        }

        // Divider
        Rectangle {
            width: 1px;
            height: 18px;
            background: ThemePalette.border_subtle;
            y: (parent.height - self.height) / 2;
        }

        // Quick Search Input with Lucide Search Icon
        Rectangle {
            width: 160px;
            height: 32px;
            border-radius: 16px;
            background: ThemePalette.bg_surface;
            border-width: 1px;
            border-color: ThemePalette.border_subtle;
            y: (parent.height - self.height) / 2;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;

                    IconDisplay {
                        icon: IconSet.Search;
                        size: 14px;
                        stroke: ThemePalette.text_muted;
                        stroke-width: 2.0;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                input := TextInput {
                    text <=> root.search_query;
                    font-size: 11px;
                    color: ThemePalette.text_primary;
                    vertical-alignment: center;
                    edited => { root.search_changed(self.text); }
                }
            }
        }

        // Settings Button with Lucide Settings Icon
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: set_touch.has-hover ? ThemePalette.bg_hover : transparent;
            y: (parent.height - self.height) / 2;
            animate background { duration: 120ms; }

            IconDisplay {
                icon: IconSet.Settings;
                size: 17px;
                stroke: set_touch.has-hover ? ThemePalette.accent_primary : ThemePalette.text_secondary;
                stroke-width: 2.0;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            set_touch := TouchArea {
                clicked => { root.open_settings(); }
            }
        }
    }
}
