import { ThemePalette } from "../theme.slint";

export component AudioBadge inherits Rectangle {
    in property <string> format: "FLAC";
    in property <int> bit_depth: 24;
    in property <int> sample_rate: 96000;
    in property <bool> is_exclusive: false;

    height: 28px;
    border-radius: 6px;
    background: ThemePalette.bg_elevated;
    border-width: 1px;
    border-color: ThemePalette.border_subtle;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: center;

        // Pulsing LED indicator for WASAPI Exclusive
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: root.is_exclusive ? #00E676 : #FFB300;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.format + " • " + (root.bit_depth > 0 ? root.bit_depth + "-BIT / " : "") + 
                  (root.sample_rate >= 1000 ? (root.sample_rate / 1000) + "kHz" : root.sample_rate + "Hz") +
                  (root.is_exclusive ? " • WASAPI EXCLUSIVE" : " • SHARED");
            font-size: 11px;
            font-weight: 700;
            color: root.is_exclusive ? #00E676 : ThemePalette.text_secondary;
            vertical-alignment: center;
        }
    }
}
