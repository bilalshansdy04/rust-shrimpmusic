import { ThemePalette } from "../theme.slint";
import { ListView } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { TrackItemModel, PlaylistItemModel } from "../models.slint";
export { PlaylistItemModel }

export component PlaylistView inherits Rectangle {
    in property <[PlaylistItemModel]> playlists: [];
    in property <[TrackItemModel]> playlist_tracks: [];
    in property <int> active_playing_id: -1;
    in-out property <int> selected_playlist_id: -1;
    in-out property <string> selected_playlist_name: "";

    callback create_playlist(string);
    callback rename_playlist(int, string);
    callback delete_playlist(int);
    callback play_playlist(int);
    callback export_playlist(int);
    callback import_playlist();
    callback select_playlist(int);
    callback back_to_playlists();
    callback track_double_clicked(int);
    callback remove_track_from_playlist(int, int);

    background: transparent;

    property <bool> show_create_modal: false;
    property <string> new_playlist_name: "";

    property <bool> show_rename_modal: false;
    property <int> renaming_playlist_id: -1;
    property <string> renaming_playlist_name: "";

    property <bool> show_delete_modal: false;
    property <int> deleting_playlist_id: -1;
    property <string> deleting_playlist_name: "";

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // Header Section (when in main playlist list view)
        if root.selected_playlist_id < 0 : HorizontalLayout {
            height: 40px;
            alignment: space-between;

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: "Koleksi Playlist";
                    font-size: 20px;
                    font-weight: 800;
                    color: ThemePalette.text_primary;
                }

                Text {
                    text: root.playlists.length + " playlist tersimpan";
                    font-size: 11px;
                    color: ThemePalette.text_secondary;
                }
            }

            // Action Buttons
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                // Import M3U8 Button
                Rectangle {
                    width: 120px;
                    height: 34px;
                    border-radius: 17px;
                    background: imp_touch.has-hover ? ThemePalette.bg_elevated : ThemePalette.bg_surface;
                    border-width: 1px;
                    border-color: ThemePalette.border_subtle;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        IconDisplay {
                            icon: IconSet.Folder;
                            size: 14px;
                            stroke: ThemePalette.text_primary;
                            stroke-width: 2.0;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Impor M3U8";
                            font-size: 11px;
                            font-weight: 600;
                            color: ThemePalette.text_primary;
                            vertical-alignment: center;
                        }
                    }

                    imp_touch := TouchArea {
                        clicked => { root.import_playlist(); }
                    }
                }

                // Create Playlist Button
                Rectangle {
                    width: 130px;
                    height: 34px;
                    border-radius: 17px;
                    background: ThemePalette.accent_primary;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        IconDisplay {
                            icon: IconSet.Plus;
                            size: 14px;
                            stroke: #FFFFFF;
                            stroke-width: 2.2;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Buat Playlist";
                            font-size: 11px;
                            font-weight: 700;
                            color: #FFFFFF;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.new_playlist_name = "";
                            root.show_create_modal = true;
                        }
                    }
                }
            }
        }

        // Header Section (when inside a specific playlist)
        if root.selected_playlist_id >= 0 : HorizontalLayout {
            height: 40px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 14px;
                alignment: start;

                // Back Button
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: back_touch.has-hover ? ThemePalette.bg_elevated : ThemePalette.bg_surface;
                    border-width: 1px;
                    border-color: ThemePalette.border_subtle;
                    y: (parent.height - self.height) / 2;

                    IconDisplay {
                        icon: IconSet.ArrowLeft;
                        size: 16px;
                        stroke: ThemePalette.text_primary;
                        stroke-width: 2.0;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    back_touch := TouchArea {
                        clicked => { root.back_to_playlists(); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: root.selected_playlist_name;
                            font-size: 18px;
                            font-weight: 800;
                            color: ThemePalette.text_primary;
                            vertical-alignment: center;
                        }

                        // Edit Name Button in Header
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: edit_h_touch.has-hover ? ThemePalette.bg_elevated : transparent;
                            y: (parent.height - self.height) / 2;

                            IconDisplay {
                                icon: IconSet.Pencil;
                                size: 13px;
                                stroke: edit_h_touch.has-hover ? ThemePalette.accent_primary : ThemePalette.text_secondary;
                                stroke-width: 2.0;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            edit_h_touch := TouchArea {
                                clicked => {
                                    root.renaming_playlist_id = root.selected_playlist_id;
                                    root.renaming_playlist_name = root.selected_playlist_name;
                                    root.show_rename_modal = true;
                                }
                            }
                        }
                    }

                    Text {
                        text: root.playlist_tracks.length + " lagu di dalam playlist";
                        font-size: 11px;
                        color: ThemePalette.text_secondary;
                    }
                }
            }

            // Playlist Actions (Play, Export, Delete)
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                // Export
                Rectangle {
                    width: 110px;
                    height: 34px;
                    border-radius: 17px;
                    background: exp_touch.has-hover ? ThemePalette.bg_elevated : ThemePalette.bg_surface;
                    border-width: 1px;
                    border-color: ThemePalette.border_subtle;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        Text {
                            text: "Ekspor .m3u8";
                            font-size: 11px;
                            font-weight: 600;
                            color: ThemePalette.text_primary;
                            vertical-alignment: center;
                        }
                    }

                    exp_touch := TouchArea {
                        clicked => { root.export_playlist(root.selected_playlist_id); }
                    }
                }

                // Delete Playlist Button
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: del_header_touch.has-hover ? #E81123 : ThemePalette.bg_surface;
                    border-width: 1px;
                    border-color: del_header_touch.has-hover ? #E81123 : ThemePalette.border_subtle;
                    y: (parent.height - self.height) / 2;

                    IconDisplay {
                        icon: IconSet.Trash2;
                        size: 14px;
                        stroke: del_header_touch.has-hover ? #FFFFFF : ThemePalette.text_muted;
                        stroke-width: 2.0;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    del_header_touch := TouchArea {
                        clicked => {
                            root.deleting_playlist_id = root.selected_playlist_id;
                            root.deleting_playlist_name = root.selected_playlist_name;
                            root.show_delete_modal = true;
                        }
                    }
                }

                // Play All
                Rectangle {
                    width: 120px;
                    height: 34px;
                    border-radius: 17px;
                    background: ThemePalette.accent_primary;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        IconDisplay {
                            icon: IconSet.Play;
                            size: 14px;
                            stroke: #FFFFFF;
                            stroke-fill: #FFFFFF;
                            stroke-width: 2.0;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Putar Semua";
                            font-size: 11px;
                            font-weight: 700;
                            color: #FFFFFF;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => { root.play_playlist(root.selected_playlist_id); }
                    }
                }
            }
        }

        // Empty State: No Playlists Created Yet
        if root.selected_playlist_id < 0 && root.playlists.length == 0 : Rectangle {
            background: ThemePalette.bg_surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: ThemePalette.border_subtle;

            VerticalLayout {
                alignment: center;
                spacing: 16px;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    background: ThemePalette.accent_subtle;
                    border-radius: 16px;
                    x: (parent.width - self.width) / 2;

                    IconDisplay {
                        icon: IconSet.ListMusic;
                        size: 32px;
                        stroke: ThemePalette.accent_primary;
                        stroke-width: 2.0;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Text {
                    text: "Belum Ada Playlist";
                    font-size: 18px;
                    font-weight: 700;
                    color: ThemePalette.text_primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Buat playlist pertama Anda untuk mengelompokkan lagu favorit lintas-folder atau impor dari file .m3u8.";
                    font-size: 13px;
                    color: ThemePalette.text_secondary;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 180px;
                        height: 42px;
                        border-radius: 21px;
                        background: ThemePalette.accent_primary;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            IconDisplay {
                                icon: IconSet.Plus;
                                size: 16px;
                                stroke: #FFFFFF;
                                stroke-width: 2.2;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Buat Playlist Baru";
                                font-size: 12px;
                                font-weight: 700;
                                color: #FFFFFF;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.new_playlist_name = "";
                                root.show_create_modal = true;
                            }
                        }
                    }
                }
            }
        }

        // Playlist Cards List View
        if root.selected_playlist_id < 0 && root.playlists.length > 0 : ListView {
            for pl[index] in root.playlists : Rectangle {
                height: 68px;
                background: pl_touch.has-hover ? ThemePalette.bg_elevated : ThemePalette.bg_surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: ThemePalette.border_subtle;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 14px;
                    alignment: space-between;

                    // Left: Icon & Info
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;

                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 10px;
                            background: ThemePalette.accent_subtle;
                            y: (parent.height - self.height) / 2;

                            IconDisplay {
                                icon: IconSet.ListMusic;
                                size: 22px;
                                stroke: ThemePalette.accent_primary;
                                stroke-width: 2.0;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: pl.name;
                                font-size: 14px;
                                font-weight: 700;
                                color: ThemePalette.text_primary;
                            }

                            Text {
                                text: pl.track_count + " lagu" + (pl.description != "" ? " • " + pl.description : "");
                                font-size: 11px;
                                color: ThemePalette.text_secondary;
                            }
                        }
                    }

                    // Right: Actions (Play, Edit Name, Delete with confirmation)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Play Button
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: play_pl_touch.has-hover ? ThemePalette.accent_primary : transparent;
                            border-width: 1px;
                            border-color: play_pl_touch.has-hover ? ThemePalette.accent_primary : ThemePalette.border_subtle;
                            y: (parent.height - self.height) / 2;

                            IconDisplay {
                                icon: IconSet.Play;
                                size: 14px;
                                stroke: play_pl_touch.has-hover ? #FFFFFF : ThemePalette.accent_primary;
                                stroke-fill: play_pl_touch.has-hover ? #FFFFFF : ThemePalette.accent_primary;
                                stroke-width: 2.0;
                                x: (parent.width - self.width) / 2 + 1px;
                                y: (parent.height - self.height) / 2;
                            }

                            play_pl_touch := TouchArea {
                                clicked => { root.play_playlist(pl.id); }
                            }
                        }

                        // Edit / Rename Button
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: edit_pl_touch.has-hover ? ThemePalette.bg_elevated : transparent;
                            border-width: 1px;
                            border-color: edit_pl_touch.has-hover ? ThemePalette.accent_primary : ThemePalette.border_subtle;
                            y: (parent.height - self.height) / 2;

                            IconDisplay {
                                icon: IconSet.Pencil;
                                size: 14px;
                                stroke: edit_pl_touch.has-hover ? ThemePalette.accent_primary : ThemePalette.text_secondary;
                                stroke-width: 2.0;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            edit_pl_touch := TouchArea {
                                clicked => {
                                    root.renaming_playlist_id = pl.id;
                                    root.renaming_playlist_name = pl.name;
                                    root.show_rename_modal = true;
                                }
                            }
                        }

                        // Delete Button (Triggers Confirmation Modal)
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: del_pl_touch.has-hover ? #E81123 : transparent;
                            border-width: 1px;
                            border-color: del_pl_touch.has-hover ? #E81123 : ThemePalette.border_subtle;
                            y: (parent.height - self.height) / 2;

                            IconDisplay {
                                icon: IconSet.Trash2;
                                size: 14px;
                                stroke: del_pl_touch.has-hover ? #FFFFFF : ThemePalette.text_muted;
                                stroke-width: 2.0;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            del_pl_touch := TouchArea {
                                clicked => {
                                    root.deleting_playlist_id = pl.id;
                                    root.deleting_playlist_name = pl.name;
                                    root.show_delete_modal = true;
                                }
                            }
                        }
                    }
                }

                pl_touch := TouchArea {
                    clicked => { root.select_playlist(pl.id); }
                }
            }
        }

        // Inside Playlist: Tracks List
        if root.selected_playlist_id >= 0 : ListView {
            for track[index] in root.playlist_tracks : Rectangle {
                height: 52px;
                background: track_touch.has-hover ? ThemePalette.bg_hover : transparent;
                border-radius: 8px;

                // Col 1: Play icon or Index
                Rectangle {
                    x: 10px;
                    y: 0px;
                    width: 24px;
                    height: parent.height;

                    if track.id == root.active_playing_id : IconDisplay {
                        icon: IconSet.Play;
                        size: 14px;
                        stroke: ThemePalette.accent_primary;
                        stroke-fill: ThemePalette.accent_primary;
                        stroke-width: 2.0;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    if track.id != root.active_playing_id : Text {
                        text: (index + 1) + "";
                        font-size: 11px;
                        font-weight: 500;
                        color: ThemePalette.text_muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // Col 2: Title & Artist
                VerticalLayout {
                    x: 42px;
                    y: 0px;
                    width: Math.max(130px, (parent.width - 240px) * 0.50);
                    height: parent.height;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: track.title;
                        font-size: 13px;
                        font-weight: track.id == root.active_playing_id ? 700 : 500;
                        color: track.id == root.active_playing_id ? ThemePalette.accent_primary : ThemePalette.text_primary;
                        overflow: elide;
                    }

                    Text {
                        text: track.artist;
                        font-size: 11px;
                        color: ThemePalette.text_secondary;
                        overflow: elide;
                    }
                }

                // Col 3: Album
                VerticalLayout {
                    x: 42px + Math.max(130px, (parent.width - 240px) * 0.50) + 14px;
                    y: 0px;
                    width: Math.max(80px, (parent.width - 160px) - self.x);
                    height: parent.height;
                    alignment: center;

                    Text {
                        text: track.album;
                        font-size: 12px;
                        color: ThemePalette.text_secondary;
                        overflow: elide;
                    }
                }

                // Col 4: Hi-Res Badge
                Rectangle {
                    x: parent.width - 150px;
                    y: (parent.height - self.height) / 2;
                    width: 48px;
                    height: 20px;

                    if track.is_hi_res : Rectangle {
                        width: 44px;
                        height: 18px;
                        border-radius: 4px;
                        background: ThemePalette.accent_subtle;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;

                        Text {
                            text: "Hi-Res";
                            font-size: 9px;
                            font-weight: 700;
                            color: ThemePalette.accent_primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Col 5: Duration
                Rectangle {
                    x: parent.width - 96px;
                    y: 0px;
                    width: 44px;
                    height: parent.height;

                    Text {
                        text: track.duration_str;
                        font-size: 11px;
                        font-weight: 500;
                        color: ThemePalette.text_muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // Col 6: Remove from playlist button
                Rectangle {
                    x: parent.width - 42px;
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: rm_touch.has-hover ? #E81123 : transparent;

                    IconDisplay {
                        icon: IconSet.X;
                        size: 12px;
                        stroke: rm_touch.has-hover ? #FFFFFF : ThemePalette.text_muted;
                        stroke-width: 2.0;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    rm_touch := TouchArea {
                        clicked => {
                            root.remove_track_from_playlist(root.selected_playlist_id, track.id);
                        }
                    }
                }

                track_touch := TouchArea {
                    double-clicked => { root.track_double_clicked(track.id); }
                }
            }
        }
    }

    // Modal 1: Buat Playlist Baru Dialog
    if root.show_create_modal : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000B3;

        TouchArea {
            // Absorb backdrop clicks
        }

        Rectangle {
            width: 380px;
            height: 200px;
            border-radius: 16px;
            background: ThemePalette.bg_surface;
            border-width: 1px;
            border-color: ThemePalette.border_subtle;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "Buat Playlist Baru";
                        font-size: 16px;
                        font-weight: 800;
                        color: ThemePalette.text_primary;
                    }

                    Text {
                        text: "Masukkan nama untuk playlist musik Anda:";
                        font-size: 11px;
                        color: ThemePalette.text_secondary;
                    }
                }

                Rectangle {
                    height: 38px;
                    background: ThemePalette.bg_elevated;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: ThemePalette.border_subtle;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        pl_input := TextInput {
                            text <=> root.new_playlist_name;
                            font-size: 13px;
                            color: ThemePalette.text_primary;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    // Cancel
                    Rectangle {
                        width: 80px;
                        height: 34px;
                        border-radius: 17px;
                        background: cancel_touch.has-hover ? ThemePalette.bg_elevated : transparent;

                        Text {
                            text: "Batal";
                            font-size: 12px;
                            font-weight: 600;
                            color: ThemePalette.text_secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        cancel_touch := TouchArea {
                            clicked => { root.show_create_modal = false; }
                        }
                    }

                    // Create
                    Rectangle {
                        width: 110px;
                        height: 34px;
                        border-radius: 17px;
                        background: ThemePalette.accent_primary;

                        Text {
                            text: "Buat Playlist";
                            font-size: 12px;
                            font-weight: 700;
                            color: #FFFFFF;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        TouchArea {
                            clicked => {
                                if (root.new_playlist_name != "") {
                                    root.create_playlist(root.new_playlist_name);
                                    root.show_create_modal = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal 2: Ubah Nama Playlist Dialog
    if root.show_rename_modal : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000B3;

        TouchArea {
            // Absorb backdrop clicks
        }

        Rectangle {
            width: 380px;
            height: 200px;
            border-radius: 16px;
            background: ThemePalette.bg_surface;
            border-width: 1px;
            border-color: ThemePalette.border_subtle;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "Ubah Nama Playlist";
                        font-size: 16px;
                        font-weight: 800;
                        color: ThemePalette.text_primary;
                    }

                    Text {
                        text: "Masukkan nama baru untuk playlist ini:";
                        font-size: 11px;
                        color: ThemePalette.text_secondary;
                    }
                }

                Rectangle {
                    height: 38px;
                    background: ThemePalette.bg_elevated;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: ThemePalette.border_subtle;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        rename_input := TextInput {
                            text <=> root.renaming_playlist_name;
                            font-size: 13px;
                            color: ThemePalette.text_primary;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    // Cancel
                    Rectangle {
                        width: 80px;
                        height: 34px;
                        border-radius: 17px;
                        background: cancel_rename_touch.has-hover ? ThemePalette.bg_elevated : transparent;

                        Text {
                            text: "Batal";
                            font-size: 12px;
                            font-weight: 600;
                            color: ThemePalette.text_secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        cancel_rename_touch := TouchArea {
                            clicked => { root.show_rename_modal = false; }
                        }
                    }

                    // Save Changes
                    Rectangle {
                        width: 140px;
                        height: 34px;
                        border-radius: 17px;
                        background: ThemePalette.accent_primary;

                        Text {
                            text: "Simpan Perubahan";
                            font-size: 12px;
                            font-weight: 700;
                            color: #FFFFFF;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        TouchArea {
                            clicked => {
                                if (root.renaming_playlist_name != "") {
                                    root.rename_playlist(root.renaming_playlist_id, root.renaming_playlist_name);
                                    root.show_rename_modal = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal 3: Validasi Konfirmasi Hapus Playlist
    if root.show_delete_modal : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000B3;

        TouchArea {
            // Absorb backdrop clicks
        }

        Rectangle {
            width: 420px;
            height: 220px;
            border-radius: 16px;
            background: ThemePalette.bg_surface;
            border-width: 1px;
            border-color: ThemePalette.border_subtle;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: #E8112322;
                        y: (parent.height - self.height) / 2;

                        IconDisplay {
                            icon: IconSet.Trash2;
                            size: 20px;
                            stroke: #E81123;
                            stroke-width: 2.0;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: "Hapus Playlist?";
                            font-size: 16px;
                            font-weight: 800;
                            color: ThemePalette.text_primary;
                        }

                        Text {
                            text: "Konfirmasi Penghapusan";
                            font-size: 11px;
                            color: ThemePalette.text_muted;
                        }
                    }
                }

                Text {
                    text: "Apakah Anda yakin ingin menghapus playlist '" + root.deleting_playlist_name + "'? File lagu Anda tetap aman dan tidak akan terhapus dari komputer.";
                    font-size: 12px;
                    color: ThemePalette.text_secondary;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    // Cancel
                    Rectangle {
                        width: 80px;
                        height: 34px;
                        border-radius: 17px;
                        background: cancel_del_touch.has-hover ? ThemePalette.bg_elevated : transparent;

                        Text {
                            text: "Batal";
                            font-size: 12px;
                            font-weight: 600;
                            color: ThemePalette.text_secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        cancel_del_touch := TouchArea {
                            clicked => { root.show_delete_modal = false; }
                        }
                    }

                    // Confirm Delete
                    Rectangle {
                        width: 120px;
                        height: 34px;
                        border-radius: 17px;
                        background: #E81123;

                        Text {
                            text: "Hapus Playlist";
                            font-size: 12px;
                            font-weight: 700;
                            color: #FFFFFF;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        TouchArea {
                            clicked => {
                                root.delete_playlist(root.deleting_playlist_id);
                                if (root.selected_playlist_id == root.deleting_playlist_id) {
                                    root.selected_playlist_id = -1;
                                }
                                root.show_delete_modal = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
