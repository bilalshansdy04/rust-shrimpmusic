import { ThemePalette } from "../theme.slint";
import { AlbumCard } from "../components/album_card.slint";
import { AudioBadge } from "../components/badge.slint";
import { Seekbar } from "../components/seekbar.slint";
import { TransportControls } from "../components/transport.slint";
import { Slider } from "@material";
import { IconDisplay, IconSet } from "@lucide";

export component AcousticStage inherits Rectangle {
    in property <image> cover_image;
    in property <bool> has_cover: false;
    in property <string> track_title: "Belum Memutar Lagu";
    in property <string> track_artist: "Pilih lagu dari pustaka";
    in property <string> track_album: "";
    in property <string> audio_format: "FLAC";
    in property <int> bit_depth: 24;
    in property <int> sample_rate: 96000;
    in property <bool> is_exclusive: false;

    in property <bool> is_playing: false;
    in property <bool> is_shuffle: false;
    in property <int> shuffle_style: 0;
    in property <int> loop_mode: 0;
    in-out property <float> volume: 0.7;
    in property <int> position_ms: 0;
    in property <int> duration_ms: 1;
    in property <[float]> waveform_peaks: [];

    callback toggle_play();
    callback previous();
    callback next();
    callback toggle_shuffle();
    callback cycle_loop();
    callback set_volume(float);
    callback seek_to(int);

    property <bool> show_volume_popup: false;

    background: ThemePalette.bg_surface;

    // Right divider border line
    Rectangle {
        x: parent.width - 1px;
        y: 0;
        width: 1px;
        height: 100%;
        background: ThemePalette.border_subtle;
    }

    VerticalLayout {
        padding-top: 24px;
        padding-bottom: 24px;
        padding-left: 28px;
        padding-right: 28px;
        spacing: 16px;
        alignment: space-between;

        // Album Card Area (Centered, capped size)
        HorizontalLayout {
            alignment: center;
            height: 220px;

            Rectangle {
                width: 220px;
                height: 220px;

                AlbumCard {
                    cover_image: root.cover_image;
                    has_cover: root.has_cover;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // Hardware Audio Badge
        HorizontalLayout {
            alignment: center;
            AudioBadge {
                format: root.audio_format;
                bit_depth: root.bit_depth;
                sample_rate: root.sample_rate;
                is_exclusive: root.is_exclusive;
            }
        }

        // Song & Artist Info
        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: root.track_title;
                font-size: 18px;
                font-weight: 800;
                color: ThemePalette.text_primary;
                horizontal-alignment: center;
                overflow: elide;
            }

            Text {
                text: root.track_artist + (root.track_album != "" ? " — " + root.track_album : "");
                font-size: 13px;
                font-weight: 500;
                color: ThemePalette.text_secondary;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        // Seekbar with Waveform & Material 3 Slider
        Seekbar {
            position_ms: root.position_ms;
            duration_ms: root.duration_ms;
            waveform_peaks: root.waveform_peaks;
            seek_to(ms) => { root.seek_to(ms); }
        }

        // Transport Controls
        TransportControls {
            is_playing: root.is_playing;
            is_shuffle: root.is_shuffle;
            shuffle_style: root.shuffle_style;
            loop_mode: root.loop_mode;
            volume: root.volume;
            is_volume_popup_open: root.show_volume_popup;

            toggle_play => { root.toggle_play(); }
            previous => { root.previous(); }
            next => { root.next(); }
            toggle_shuffle => { root.toggle_shuffle(); }
            cycle_loop => { root.cycle_loop(); }
            set_volume(v) => { root.set_volume(v); }
            toggle_volume_popup => { root.show_volume_popup = !root.show_volume_popup; }
        }
    }

    // Dismiss backdrop when clicking outside volume popup
    if root.show_volume_popup : TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.show_volume_popup = false; }
    }

    // Slim & Compact Vertical Volume Popup Card (Directly above volume button)
    if root.show_volume_popup : Rectangle {
        x: Math.max(10px, Math.min(parent.width - self.width - 12px, (parent.width / 2) + 126px));
        y: parent.height - self.height - 86px;
        width: 48px;
        height: 156px;
        background: ThemePalette.bg_elevated;
        border-radius: 16px;
        border-width: 1px;
        border-color: ThemePalette.border_subtle;

        // Absorb clicks on card so backdrop doesn't close it
        TouchArea {
            width: 100%;
            height: 100%;

            scroll-event(event) => {
                let delta = event.delta-y / 120px;
                root.set_volume(Math.min(1.0, Math.max(0.0, root.volume + delta * 0.05)));
                accept
            }
        }

        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            alignment: space-between;

            // Volume Percentage Label (Up to 100%)
            Text {
                text: Math.round(root.volume * 100) + "%";
                font-size: 11px;
                font-weight: 700;
                color: ThemePalette.accent_primary;
                horizontal-alignment: center;
            }

            // Vertical Slider Track Area
            Rectangle {
                width: 36px;
                height: 94px;
                x: (parent.width - self.width) / 2;

                // Groove
                Rectangle {
                    width: 6px;
                    height: 100%;
                    border-radius: 3px;
                    background: ThemePalette.bg_surface;
                    x: (parent.width - self.width) / 2;

                    // Active Fill (grows from bottom up)
                    Rectangle {
                        y: parent.height - self.height;
                        width: 100%;
                        height: parent.height * Math.min(1.0, Math.max(0.0, root.volume));
                        border-radius: 3px;
                        background: ThemePalette.accent_primary;
                    }

                    // White Thumb Knob
                    Rectangle {
                        x: -5px;
                        y: Math.max(0px, Math.min(parent.height - 16px, parent.height * (1.0 - Math.min(1.0, Math.max(0.0, root.volume))) - 8px));
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: #FFFFFF;
                    }
                }

                // Interactive TouchArea for 0% - 100% sliding
                TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            let ratio = 1.0 - Math.min(1.0, Math.max(0.0, self.mouse-y / self.height));
                            root.volume = ratio;
                            root.set_volume(ratio);
                        }
                    }

                    moved => {
                        if (self.pressed) {
                            let ratio = 1.0 - Math.min(1.0, Math.max(0.0, self.mouse-y / self.height));
                            root.volume = ratio;
                            root.set_volume(ratio);
                        }
                    }

                    scroll-event(event) => {
                        let delta = event.delta-y / 120px;
                        root.set_volume(Math.min(1.0, Math.max(0.0, root.volume + delta * 0.05)));
                        accept
                    }
                }
            }

            // Quick Mute / Unmute Button
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: mute_touch.has-hover ? ThemePalette.bg_surface : transparent;
                x: (parent.width - self.width) / 2;

                IconDisplay {
                    icon: root.volume == 0.0 ? IconSet.VolumeX : (root.volume < 0.5 ? IconSet.Volume1 : IconSet.Volume2);
                    size: 16px;
                    stroke: root.volume == 0.0 ? ThemePalette.text_muted : ThemePalette.accent_primary;
                    stroke-width: 2.0;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                mute_touch := TouchArea {
                    clicked => {
                        if (root.volume > 0.0) {
                            root.set_volume(0.0);
                        } else {
                            root.set_volume(0.7);
                        }
                    }
                }
            }
        }
    }
}
