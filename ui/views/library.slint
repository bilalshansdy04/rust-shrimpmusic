import { ThemePalette } from "../theme.slint";
import { ListView } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { TrackItemModel, FolderScopeModel, PlaylistItemModel } from "../models.slint";
export { TrackItemModel, FolderScopeModel }

export component LibraryView inherits Rectangle {
    in property <[TrackItemModel]> tracks: [];
    in property <[FolderScopeModel]> folder_scopes: [];
    in property <[PlaylistItemModel]> playlists: [];
    in property <int> selected_track_id: -1;
    in property <int> active_playing_id: -1;
    in property <int> total_folders: 0;
    in property <bool> is_scanning: false;
    in property <string> scan_status_text: "Memindai folder musik...";
    in property <int> sort_criteria: 0; // 0: Title, 1: Artist, 2: Album, 5: DateAdded
    in property <bool> sort_ascending: true;
    in property <int> selected_count: 0;

    callback track_selected(int);
    callback track_double_clicked(int);
    callback scope_changed(int);
    callback sort_changed(int, bool);
    callback add_folder_clicked();

    // Context & Batch Actions
    callback add_to_queue(int);
    callback add_to_playlist(int, int); // (playlist_id, track_id)
    callback add_selected_to_playlist(int); // (playlist_id)
    callback add_selected_to_queue();
    callback delete_track_from_db(int);
    callback delete_selected_from_db();
    callback create_playlist_with_tracks(string, int);
    callback toggle_select_track(int);
    callback select_all_tracks();
    callback clear_selection();

    // Context Menu & Multi-selection State
    property <bool> show_context_menu: false;
    property <length> context_menu_x: 0px;
    property <length> context_menu_y: 0px;
    property <int> context_track_id: -1;
    property <string> context_track_title: "";
    property <bool> show_playlist_submenu: false;
    property <bool> show_new_playlist_input: false;
    property <string> new_playlist_name: "";
    property <bool> is_selection_mode: false;
    property <bool> show_sort_menu: false;

    background: transparent;

    VerticalLayout {
        padding-left: 20px;
        padding-right: 24px;
        padding-top: 14px;
        padding-bottom: 16px;
        spacing: 12px;

        // Scanning Status Banner
        if root.is_scanning : Rectangle {
            height: 48px;
            background: ThemePalette.bg_elevated;
            border-radius: 10px;
            border-width: 1px;
            border-color: ThemePalette.accent_primary;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: start;

                IconDisplay {
                    icon: IconSet.Zap;
                    size: 18px;
                    stroke: ThemePalette.accent_primary;
                    stroke-width: 2.0;
                    y: (parent.height - self.height) / 2;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: "Sedang Memindai Koleksi Musik...";
                        font-size: 12px;
                        font-weight: 700;
                        color: ThemePalette.accent_primary;
                    }

                    Text {
                        text: root.scan_status_text;
                        font-size: 11px;
                        color: ThemePalette.text_secondary;
                        overflow: elide;
                    }
                }
            }
        }

        // Top Filter & Actions Bar
        HorizontalLayout {
            height: 38px;
            spacing: 12px;
            alignment: space-between;

            // Scope Pills (Horizontal flex)
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                horizontal-stretch: 1;

                for scope in root.folder_scopes : Rectangle {
                    height: 30px;
                    border-radius: 15px;
                    background: scope.is_selected ? ThemePalette.accent_primary : (s_touch.has-hover ? ThemePalette.bg_elevated : ThemePalette.bg_surface);
                    border-width: 1px;
                    border-color: ThemePalette.border_subtle;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;

                        Text {
                            text: scope.display_name;
                            font-size: 11px;
                            font-weight: scope.is_selected ? 700 : 500;
                            color: scope.is_selected ? #FFFFFF : ThemePalette.text_primary;
                            vertical-alignment: center;
                        }
                    }

                    s_touch := TouchArea {
                        clicked => { root.scope_changed(scope.id); }
                    }
                }
            }

            // Add Folder Quick Button (Fixed width, never squished)
            Rectangle {
                width: 128px;
                height: 30px;
                border-radius: 15px;
                background: add_touch.has-hover ? ThemePalette.bg_elevated : ThemePalette.bg_surface;
                border-width: 1px;
                border-color: ThemePalette.border_subtle;
                y: (parent.height - self.height) / 2;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: center;

                    IconDisplay {
                        icon: IconSet.FolderPlus;
                        size: 14px;
                        stroke: ThemePalette.accent_primary;
                        stroke-width: 2.0;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Tambah Folder";
                        font-size: 11px;
                        font-weight: 600;
                        color: ThemePalette.text_primary;
                        vertical-alignment: center;
                    }
                }

                add_touch := TouchArea {
                    clicked => { root.add_folder_clicked(); }
                }
            }
        }

        // Sorting Sub-bar (Filter urutan: Judul, Artis, Album, Tgl Ditambahkan & Asc/Desc) + Selection Mode Toolbar
        if root.tracks.length > 0 : HorizontalLayout {
            height: 28px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                // Selection toolbar is only shown when selection mode is activated!
                if root.is_selection_mode : HorizontalLayout {
                    spacing: 8px;

                    // Select All / Clear Selection Button
                    Rectangle {
                        width: 125px;
                        height: 26px;
                        border-radius: 6px;
                        background: sel_btn_touch.has-hover ? ThemePalette.bg_elevated : ThemePalette.bg_surface;
                        border-width: 1px;
                        border-color: root.selected_count > 0 ? ThemePalette.accent_primary : ThemePalette.border_subtle;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            IconDisplay {
                                icon: root.selected_count > 0 ? IconSet.CheckSquare : IconSet.Square;
                                size: 13px;
                                stroke: root.selected_count > 0 ? ThemePalette.accent_primary : ThemePalette.text_muted;
                                stroke-width: 1.8;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: root.selected_count > 0 ? ("Terpilih (" + root.selected_count + ")") : "Pilih Semua";
                                font-size: 11px;
                                font-weight: 600;
                                color: root.selected_count > 0 ? ThemePalette.accent_primary : ThemePalette.text_secondary;
                                vertical-alignment: center;
                            }
                        }

                        sel_btn_touch := TouchArea {
                            clicked => {
                                if root.selected_count > 0 {
                                    root.clear_selection();
                                } else {
                                    root.select_all_tracks();
                                }
                            }
                        }
                    }

                    // Batch Action: Tambah ke Antrean (jika ada terpilih)
                    if root.selected_count > 0 : Rectangle {
                        width: 110px;
                        height: 26px;
                        border-radius: 6px;
                        background: ThemePalette.accent_subtle;
                        border-width: 1px;
                        border-color: ThemePalette.accent_primary;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            IconDisplay {
                                icon: IconSet.ListPlus;
                                size: 13px;
                                stroke: ThemePalette.accent_primary;
                                stroke-width: 1.8;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "+ Ke Antrean";
                                font-size: 11px;
                                font-weight: 700;
                                color: ThemePalette.accent_primary;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.add_selected_to_queue(); }
                        }
                    }

                    // Batch Action: Hapus Terpilih dari DB
                    if root.selected_count > 0 : Rectangle {
                        width: 80px;
                        height: 26px;
                        border-radius: 6px;
                        background: #dc262622;
                        border-width: 1px;
                        border-color: #dc262666;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            IconDisplay {
                                icon: IconSet.Trash2;
                                size: 13px;
                                stroke: #ef4444;
                                stroke-width: 1.8;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Hapus";
                                font-size: 11px;
                                font-weight: 700;
                                color: #ef4444;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.delete_selected_from_db(); }
                        }
                    }

                    // Exit / Cancel selection mode button
                    Rectangle {
                        width: 75px;
                        height: 26px;
                        border-radius: 6px;
                        background: close_sel_t.has-hover ? #dc262622 : ThemePalette.bg_surface;
                        border-width: 1px;
                        border-color: close_sel_t.has-hover ? #ef4444 : ThemePalette.border_subtle;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;

                            IconDisplay {
                                icon: IconSet.X;
                                size: 12px;
                                stroke: close_sel_t.has-hover ? #ef4444 : ThemePalette.text_muted;
                                stroke-width: 2.0;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Batal";
                                font-size: 11px;
                                font-weight: 600;
                                color: close_sel_t.has-hover ? #ef4444 : ThemePalette.text_muted;
                                vertical-alignment: center;
                            }
                        }

                        close_sel_t := TouchArea {
                            clicked => {
                                root.is_selection_mode = false;
                                root.clear_selection();
                            }
                        }
                    }
                }
            }

            // Spotify-style Sort Dropdown Button (Replaces old multi-pill bar)
            Rectangle {
                height: 28px;
                border-radius: 6px;
                background: sort_btn_touch.has-hover ? ThemePalette.bg_elevated : transparent;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: root.sort_criteria == 0 ? "Title" :
                             (root.sort_criteria == 1 ? "Artist" :
                             (root.sort_criteria == 2 ? "Album" :
                             (root.sort_criteria == 3 ? "Track Number" :
                             (root.sort_criteria == 4 ? "Duration" :
                             (root.sort_criteria == 5 ? "Recently added" : "Audio specs")))));
                        font-size: 12px;
                        font-weight: 600;
                        color: ThemePalette.text_secondary;
                        vertical-alignment: center;
                    }

                    IconDisplay {
                        icon: IconSet.ListFilter;
                        size: 14px;
                        stroke: ThemePalette.text_secondary;
                        stroke-width: 2.0;
                        y: (parent.height - self.height) / 2;
                    }
                }

                sort_btn_touch := TouchArea {
                    clicked => {
                        root.show_sort_menu = !root.show_sort_menu;
                    }
                }
            }
        }

        // Empty State (If no tracks/folders)
        if root.tracks.length == 0 : Rectangle {
            background: ThemePalette.bg_surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: ThemePalette.border_subtle;

            VerticalLayout {
                alignment: center;
                spacing: 16px;

                Rectangle {
                    width: 72px;
                    height: 64px;
                    background: ThemePalette.accent_subtle;
                    border-radius: 16px;
                    x: (parent.width - self.width) / 2;

                    IconDisplay {
                        icon: root.is_scanning ? IconSet.RotateCw : IconSet.Folder;
                        size: 32px;
                        stroke: ThemePalette.accent_primary;
                        stroke-width: 2.0;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Text {
                    text: root.is_scanning ? "Sedang Memindai Pustaka..." : "Pustaka Musik Anda Masih Kosong";
                    font-size: 18px;
                    font-weight: 700;
                    color: ThemePalette.text_primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.is_scanning ? root.scan_status_text : "Mulai nikmati musik berkualitas tinggi dengan menambahkan folder koleksi lagu Anda.";
                    font-size: 13px;
                    color: ThemePalette.text_secondary;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 180px;
                        height: 42px;
                        border-radius: 21px;
                        background: ThemePalette.accent_primary;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            IconDisplay {
                                icon: IconSet.FolderPlus;
                                size: 16px;
                                stroke: #FFFFFF;
                                stroke-width: 2.0;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Tambah Folder Musik";
                                font-size: 12px;
                                font-weight: 700;
                                color: #FFFFFF;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.add_folder_clicked(); }
                        }
                    }
                }
            }
        }

        // Track List View (Laser-straight column alignment)
        if root.tracks.length > 0 : ListView {
            for track[index] in root.tracks : Rectangle {
                height: 52px;
                background: track.is_selected ? ThemePalette.accent_subtle :
                           (track.id == root.selected_track_id ? ThemePalette.bg_elevated :
                           (row_touch.has-hover ? ThemePalette.bg_hover : transparent));
                border-radius: 8px;

                // Col 0: Checkbox toggle for multi-selection (only when selection mode is active)
                if root.is_selection_mode : Rectangle {
                    x: 6px;
                    y: (parent.height - self.height) / 2;
                    width: 20px;
                    height: 20px;

                    IconDisplay {
                        icon: track.is_selected ? IconSet.CheckSquare : IconSet.Square;
                        size: 14px;
                        stroke: track.is_selected ? ThemePalette.accent_primary : ThemePalette.border_subtle;
                        stroke-width: 1.8;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    TouchArea {
                        clicked => {
                            root.toggle_select_track(track.id);
                        }
                    }
                }

                // Col 1: Play status or index (x: 28px when selection mode, or x: 10px in normal mode)
                Rectangle {
                    x: root.is_selection_mode ? 28px : 10px;
                    y: 0px;
                    width: 24px;
                    height: parent.height;

                    if track.id == root.active_playing_id : IconDisplay {
                        icon: IconSet.Play;
                        size: 14px;
                        stroke: ThemePalette.accent_primary;
                        stroke-fill: ThemePalette.accent_primary;
                        stroke-width: 2.0;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    if track.id != root.active_playing_id : Text {
                        text: (index + 1) + "";
                        font-size: 11px;
                        font-weight: 500;
                        color: ThemePalette.text_muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // Col 2: Title & Artist (x: 56px when selection mode, or x: 42px in normal mode)
                VerticalLayout {
                    x: root.is_selection_mode ? 56px : 42px;
                    y: 0px;
                    width: Math.max(130px, (parent.width - (root.is_selection_mode ? 254px : 240px)) * 0.50);
                    height: parent.height;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: track.title;
                        font-size: 13px;
                        font-weight: track.id == root.active_playing_id ? 700 : 500;
                        color: track.id == root.active_playing_id ? ThemePalette.accent_primary : ThemePalette.text_primary;
                        overflow: elide;
                    }

                    Text {
                        text: track.artist;
                        font-size: 11px;
                        color: ThemePalette.text_secondary;
                        overflow: elide;
                    }
                }

                // Col 3: Album (Strict fixed start at same pixel on all rows)
                VerticalLayout {
                    x: (root.is_selection_mode ? 56px : 42px) + Math.max(130px, (parent.width - (root.is_selection_mode ? 254px : 240px)) * 0.50) + 14px;
                    y: 0px;
                    width: Math.max(80px, (parent.width - 124px) - self.x);
                    height: parent.height;
                    alignment: center;

                    Text {
                        text: track.album;
                        font-size: 12px;
                        color: ThemePalette.text_secondary;
                        overflow: elide;
                    }
                }

                // Col 4: Hi-Res Badge slot (Strict fixed position x: parent.width - 116px)
                Rectangle {
                    x: parent.width - 116px;
                    y: (parent.height - self.height) / 2;
                    width: 48px;
                    height: 20px;

                    if track.is_hi_res : Rectangle {
                        width: 44px;
                        height: 18px;
                        border-radius: 4px;
                        background: ThemePalette.accent_subtle;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;

                        Text {
                            text: "Hi-Res";
                            font-size: 9px;
                            font-weight: 700;
                            color: ThemePalette.accent_primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Col 5: Duration (Strict fixed position x: parent.width - 62px, 14px right margin)
                Rectangle {
                    x: parent.width - 62px;
                    y: 0px;
                    width: 48px;
                    height: parent.height;

                    Text {
                        text: track.duration_str;
                        font-size: 11px;
                        font-weight: 500;
                        color: ThemePalette.text_muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                row_touch := TouchArea {
                    clicked => { root.track_selected(track.id); }
                    double-clicked => { root.track_double_clicked(track.id); }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            root.track_selected(track.id);
                            root.context_track_id = track.id;
                            root.context_track_title = track.title;
                            // Clamp context menu popup position
                            root.context_menu_x = Math.min(root.width - 250px, Math.max(10px, self.mouse-x + 40px));
                            root.context_menu_y = Math.min(root.height - 300px, Math.max(10px, (index * 52px) + 70px));
                            root.show_playlist_submenu = false;
                            root.show_new_playlist_input = false;
                            root.show_context_menu = true;
                        }
                    }
                }
            }
        }
    }

    // =========================================================
    // SPOTIFY-STYLE CONTEXT MENU OVERLAY
    // =========================================================
    if root.show_context_menu : TouchArea {
        width: 100%;
        height: 100%;
        z: 999;
        clicked => {
            root.show_context_menu = false;
            root.show_playlist_submenu = false;
            root.show_new_playlist_input = false;
        }

        Rectangle {
            x: root.context_menu_x;
            y: root.context_menu_y;
            width: 230px;
            height: ctx_layout.preferred-height;
            border-radius: 8px;
            background: ThemePalette.bg_elevated;
            border-width: 1px;
            border-color: ThemePalette.border_subtle;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;

            ctx_layout := VerticalLayout {
                padding: 6px;
                spacing: 2px;

                // Track header
                HorizontalLayout {
                    height: 26px;
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: root.context_track_title;
                        font-size: 11px;
                        font-weight: 700;
                        color: ThemePalette.text_muted;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 1px; background: ThemePalette.border_subtle; }

                // 1. Play Track
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: play_item_t.has-hover ? ThemePalette.bg_hover : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;

                        IconDisplay {
                            icon: IconSet.Play;
                            size: 14px;
                            stroke: ThemePalette.accent_primary;
                            stroke-width: 2.0;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Putar Lagu";
                            font-size: 12px;
                            color: ThemePalette.text_primary;
                            vertical-alignment: center;
                        }
                    }

                    play_item_t := TouchArea {
                        clicked => {
                            root.show_context_menu = false;
                            root.track_double_clicked(root.context_track_id);
                        }
                    }
                }

                // 2. Add to Queue
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: queue_item_t.has-hover ? ThemePalette.bg_hover : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;

                        IconDisplay {
                            icon: IconSet.ListPlus;
                            size: 14px;
                            stroke: ThemePalette.text_secondary;
                            stroke-width: 2.0;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Tambahkan ke Antrean";
                            font-size: 12px;
                            color: ThemePalette.text_primary;
                            vertical-alignment: center;
                        }
                    }

                    queue_item_t := TouchArea {
                        clicked => {
                            root.show_context_menu = false;
                            root.add_to_queue(root.context_track_id);
                        }
                    }
                }

                // 3. Add to Playlist (Toggles submenu list)
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: pl_item_t.has-hover ? ThemePalette.bg_hover : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            IconDisplay {
                                icon: IconSet.PlusSquare;
                                size: 14px;
                                stroke: ThemePalette.text_secondary;
                                stroke-width: 2.0;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Tambahkan ke Playlist";
                                font-size: 12px;
                                color: ThemePalette.text_primary;
                                vertical-alignment: center;
                            }
                        }

                        IconDisplay {
                            icon: root.show_playlist_submenu ? IconSet.ChevronDown : IconSet.ChevronRight;
                            size: 12px;
                            stroke: ThemePalette.text_muted;
                            stroke-width: 2.0;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    pl_item_t := TouchArea {
                        clicked => {
                            root.show_playlist_submenu = !root.show_playlist_submenu;
                        }
                    }
                }

                // Submenu: List of Playlists + New Playlist Option
                if root.show_playlist_submenu : VerticalLayout {
                    spacing: 2px;
                    padding-left: 14px;

                    // Option: Create New Playlist
                    Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: new_pl_t.has-hover ? ThemePalette.bg_hover : transparent;

                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 6px;
                            alignment: start;

                            IconDisplay {
                                icon: IconSet.FolderPlus;
                                size: 13px;
                                stroke: ThemePalette.accent_primary;
                                stroke-width: 2.0;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Buat Playlist Baru...";
                                font-size: 11px;
                                font-weight: 600;
                                color: ThemePalette.accent_primary;
                                vertical-alignment: center;
                            }
                        }

                        new_pl_t := TouchArea {
                            clicked => {
                                root.show_context_menu = false;
                                root.show_playlist_submenu = false;
                                root.new_playlist_name = "";
                                root.show_new_playlist_input = true;
                            }
                        }
                    }

                    // Existing Playlists
                    for pl in root.playlists : Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: pl_pick_t.has-hover ? ThemePalette.bg_hover : transparent;

                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 6px;
                            alignment: start;

                            IconDisplay {
                                icon: IconSet.Music;
                                size: 12px;
                                stroke: ThemePalette.text_muted;
                                stroke-width: 1.8;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: pl.name;
                                font-size: 11px;
                                color: ThemePalette.text_primary;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }

                        pl_pick_t := TouchArea {
                            clicked => {
                                root.show_context_menu = false;
                                root.show_playlist_submenu = false;
                                root.add_to_playlist(pl.id, root.context_track_id);
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: ThemePalette.border_subtle; }

                // 4. Mode Pilih Beberapa Lagu (Multi-Select) / Batalkan Pilihan
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: select_mode_t.has-hover ? ThemePalette.bg_hover : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;

                        IconDisplay {
                            icon: root.is_selection_mode ? IconSet.X : IconSet.CheckSquare;
                            size: 14px;
                            stroke: root.is_selection_mode ? #ef4444 : ThemePalette.text_secondary;
                            stroke-width: 2.0;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.is_selection_mode ? "Batalkan Mode Pilih" : "Pilih Beberapa Lagu";
                            font-size: 12px;
                            color: root.is_selection_mode ? #ef4444 : ThemePalette.text_primary;
                            vertical-alignment: center;
                        }
                    }

                    select_mode_t := TouchArea {
                        clicked => {
                            root.show_context_menu = false;
                            if root.is_selection_mode {
                                root.is_selection_mode = false;
                                root.clear_selection();
                            } else {
                                root.is_selection_mode = true;
                                root.toggle_select_track(root.context_track_id);
                            }
                        }
                    }
                }

                // 5. Delete track from Database
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: del_item_t.has-hover ? #dc262622 : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;

                        IconDisplay {
                            icon: IconSet.Trash2;
                            size: 14px;
                            stroke: #ef4444;
                            stroke-width: 2.0;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Hapus Lagu dari Pustaka";
                            font-size: 12px;
                            color: #ef4444;
                            vertical-alignment: center;
                        }
                    }

                    del_item_t := TouchArea {
                        clicked => {
                            root.show_context_menu = false;
                            root.delete_track_from_db(root.context_track_id);
                        }
                    }
                }
            }
        }
    }

    // =========================================================
    // MODAL DIALOG: BUAT PLAYLIST BARU (DARI CONTEXT MENU)
    // =========================================================
    if root.show_new_playlist_input : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000B3;
        z: 1000;

        TouchArea {
            // Absorb backdrop clicks
        }

        Rectangle {
            width: 380px;
            height: 200px;
            border-radius: 16px;
            background: ThemePalette.bg_surface;
            border-width: 1px;
            border-color: ThemePalette.border_subtle;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "Buat Playlist Baru";
                        font-size: 16px;
                        font-weight: 800;
                        color: ThemePalette.text_primary;
                    }

                    Text {
                        text: "Masukkan nama untuk playlist baru Anda:";
                        font-size: 11px;
                        color: ThemePalette.text_secondary;
                    }
                }

                Rectangle {
                    height: 38px;
                    background: ThemePalette.bg_elevated;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: ThemePalette.border_subtle;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        TextInput {
                            text <=> root.new_playlist_name;
                            font-size: 13px;
                            color: ThemePalette.text_primary;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    // Cancel
                    Rectangle {
                        width: 80px;
                        height: 34px;
                        border-radius: 17px;
                        background: cancel_ctx_pl_t.has-hover ? ThemePalette.bg_elevated : transparent;

                        Text {
                            text: "Batal";
                            font-size: 12px;
                            font-weight: 600;
                            color: ThemePalette.text_secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        cancel_ctx_pl_t := TouchArea {
                            clicked => {
                                root.show_new_playlist_input = false;
                                root.new_playlist_name = "";
                            }
                        }
                    }

                    // Create & Add Track
                    Rectangle {
                        width: 110px;
                        height: 34px;
                        border-radius: 17px;
                        background: ThemePalette.accent_primary;

                        Text {
                            text: "Buat Playlist";
                            font-size: 12px;
                            font-weight: 700;
                            color: #FFFFFF;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        TouchArea {
                            clicked => {
                                if (root.new_playlist_name != "") {
                                    root.create_playlist_with_tracks(root.new_playlist_name, root.context_track_id);
                                    root.show_new_playlist_input = false;
                                    root.new_playlist_name = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // =========================================================
    // SPOTIFY-STYLE SORT MENU POPUP
    // =========================================================
    if root.show_sort_menu : TouchArea {
        width: 100%;
        height: 100%;
        z: 998;
        clicked => { root.show_sort_menu = false; }

        Rectangle {
            x: parent.width - 200px;
            y: 95px;
            width: 175px;
            height: lib_sort_layout.preferred-height;
            border-radius: 8px;
            background: ThemePalette.bg_elevated;
            border-width: 1px;
            border-color: ThemePalette.border_subtle;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;

            lib_sort_layout := VerticalLayout {
                padding: 6px;
                spacing: 2px;

                // Header
                Rectangle {
                    height: 26px;
                    HorizontalLayout {
                        padding-left: 10px;
                        Text {
                            text: "Sort by";
                            font-size: 11px;
                            font-weight: 700;
                            color: ThemePalette.text_muted;
                            vertical-alignment: center;
                        }
                    }
                }

                // Item 0: Title
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: lib_it0_t.has-hover ? ThemePalette.bg_hover : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;

                        Text {
                            text: "Title";
                            font-size: 12px;
                            font-weight: root.sort_criteria == 0 ? 700 : 500;
                            color: root.sort_criteria == 0 ? ThemePalette.accent_primary : ThemePalette.text_primary;
                            vertical-alignment: center;
                        }

                        if root.sort_criteria == 0 : IconDisplay {
                            icon: root.sort_ascending ? IconSet.ArrowUp : IconSet.ArrowDown;
                            size: 14px;
                            stroke: ThemePalette.accent_primary;
                            stroke-width: 2.5;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    lib_it0_t := TouchArea {
                        clicked => {
                            if root.sort_criteria == 0 {
                                root.sort_changed(0, !root.sort_ascending);
                            } else {
                                root.sort_changed(0, true);
                            }
                            root.show_sort_menu = false;
                        }
                    }
                }

                // Item 1: Artist
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: lib_it1_t.has-hover ? ThemePalette.bg_hover : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;

                        Text {
                            text: "Artist";
                            font-size: 12px;
                            font-weight: root.sort_criteria == 1 ? 700 : 500;
                            color: root.sort_criteria == 1 ? ThemePalette.accent_primary : ThemePalette.text_primary;
                            vertical-alignment: center;
                        }

                        if root.sort_criteria == 1 : IconDisplay {
                            icon: root.sort_ascending ? IconSet.ArrowUp : IconSet.ArrowDown;
                            size: 14px;
                            stroke: ThemePalette.accent_primary;
                            stroke-width: 2.5;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    lib_it1_t := TouchArea {
                        clicked => {
                            if root.sort_criteria == 1 {
                                root.sort_changed(1, !root.sort_ascending);
                            } else {
                                root.sort_changed(1, true);
                            }
                            root.show_sort_menu = false;
                        }
                    }
                }

                // Item 2: Album
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: lib_it2_t.has-hover ? ThemePalette.bg_hover : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;

                        Text {
                            text: "Album";
                            font-size: 12px;
                            font-weight: root.sort_criteria == 2 ? 700 : 500;
                            color: root.sort_criteria == 2 ? ThemePalette.accent_primary : ThemePalette.text_primary;
                            vertical-alignment: center;
                        }

                        if root.sort_criteria == 2 : IconDisplay {
                            icon: root.sort_ascending ? IconSet.ArrowUp : IconSet.ArrowDown;
                            size: 14px;
                            stroke: ThemePalette.accent_primary;
                            stroke-width: 2.5;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    lib_it2_t := TouchArea {
                        clicked => {
                            if root.sort_criteria == 2 {
                                root.sort_changed(2, !root.sort_ascending);
                            } else {
                                root.sort_changed(2, true);
                            }
                            root.show_sort_menu = false;
                        }
                    }
                }

                // Item 3: Recently added (SortCriteria = 5)
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: lib_it5_t.has-hover ? ThemePalette.bg_hover : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;

                        Text {
                            text: "Recently added";
                            font-size: 12px;
                            font-weight: root.sort_criteria == 5 ? 700 : 500;
                            color: root.sort_criteria == 5 ? ThemePalette.accent_primary : ThemePalette.text_primary;
                            vertical-alignment: center;
                        }

                        if root.sort_criteria == 5 : IconDisplay {
                            icon: root.sort_ascending ? IconSet.ArrowUp : IconSet.ArrowDown;
                            size: 14px;
                            stroke: ThemePalette.accent_primary;
                            stroke-width: 2.5;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    lib_it5_t := TouchArea {
                        clicked => {
                            if root.sort_criteria == 5 {
                                root.sort_changed(5, !root.sort_ascending);
                            } else {
                                root.sort_changed(5, false); // Recently added default descending
                            }
                            root.show_sort_menu = false;
                        }
                    }
                }

                // Item 4: Duration (SortCriteria = 4)
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: lib_it4_t.has-hover ? ThemePalette.bg_hover : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;

                        Text {
                            text: "Duration";
                            font-size: 12px;
                            font-weight: root.sort_criteria == 4 ? 700 : 500;
                            color: root.sort_criteria == 4 ? ThemePalette.accent_primary : ThemePalette.text_primary;
                            vertical-alignment: center;
                        }

                        if root.sort_criteria == 4 : IconDisplay {
                            icon: root.sort_ascending ? IconSet.ArrowUp : IconSet.ArrowDown;
                            size: 14px;
                            stroke: ThemePalette.accent_primary;
                            stroke-width: 2.5;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    lib_it4_t := TouchArea {
                        clicked => {
                            if root.sort_criteria == 4 {
                                root.sort_changed(4, !root.sort_ascending);
                            } else {
                                root.sort_changed(4, true);
                            }
                            root.show_sort_menu = false;
                        }
                    }
                }
            }
        }
    }
}
